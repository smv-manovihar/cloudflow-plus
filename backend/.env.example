# ==============================================================================
# CloudFlow Backend Configuration (.env.example)
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ── Primary Storage (Required) ────────────────────────────────────────────────
# Configures the main storage provider where user files are stored.
# Works with AWS S3, MinIO, Cloudflare R2, Wasabi, Backblaze B2, or any S3-compatible service.

# --- Example 1: Local MinIO (Default for local development) ---
PRIMARY_STORAGE_ENDPOINT=http://localhost:9000
PRIMARY_STORAGE_ACCESS_KEY=minioadmin
PRIMARY_STORAGE_SECRET_KEY=minioadmin
PRIMARY_STORAGE_BUCKET=cloud-flow-bucket
PRIMARY_STORAGE_REGION=us-east-1

# --- Example 2: AWS S3 ---
# PRIMARY_STORAGE_ENDPOINT=
# PRIMARY_STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# PRIMARY_STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# PRIMARY_STORAGE_BUCKET=my-production-bucket
# PRIMARY_STORAGE_REGION=us-east-1

# --- Example 3: Cloudflare R2 ---
# PRIMARY_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# PRIMARY_STORAGE_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# PRIMARY_STORAGE_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# PRIMARY_STORAGE_BUCKET=my-r2-bucket
# PRIMARY_STORAGE_REGION=auto

# ── Sync Target Storage (Optional) ───────────────────────────────────────────
# If configured, allows users to toggle backup/sync of their files to a secondary S3 destination.
# Leave ACCESS_KEY and BUCKET blank or commented out to disable the sync feature completely.

# SYNC_TARGET_ENDPOINT=
# SYNC_TARGET_ACCESS_KEY=
# SYNC_TARGET_SECRET_KEY=
# SYNC_TARGET_BUCKET=
# SYNC_TARGET_REGION=us-east-1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local development (no separate database server needed)
DATABASE_URL=sqlite:///database/cloudflow.db

# PostgreSQL for production environments
# DATABASE_URL=postgresql://cloudflow_user:securepassword@localhost:5432/cloudflow_db

# ── Application & Security ────────────────────────────────────────────────────
# Allowed CORS origin for frontend requests
FRONTEND_URL=http://localhost:3000

# Secret keys for JWT access and refresh tokens (generate strong random secrets for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
REFRESH_SECRET_KEY=change-this-to-a-secure-random-refresh-secret-key-in-production
